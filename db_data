-- 9. Шаблон пар (Пн–Пт, 8 пар, обе недели)
DECLARE @days TABLE (WeekDay TINYINT);
INSERT INTO @days VALUES (1),(2),(3),(4),(5); -- Пн-Пт

INSERT INTO TimeSlots (WeekDay, PairNumber, StartTime, EndTime, WeekParity)
SELECT 
    d.WeekDay,
    p.PairNumber,
    CASE p.PairNumber
        WHEN 1 THEN '08:30' WHEN 2 THEN '10:15' WHEN 3 THEN '12:00'
        WHEN 4 THEN '13:45' WHEN 5 THEN '15:30' WHEN 6 THEN '17:15'
        WHEN 7 THEN '19:00' WHEN 8 THEN '20:45'
    END,
    CASE p.PairNumber
        WHEN 1 THEN '10:00' WHEN 2 THEN '11:45' WHEN 3 THEN '13:30'
        WHEN 4 THEN '15:15' WHEN 5 THEN '17:00' WHEN 6 THEN '18:45'
        WHEN 7 THEN '20:30' WHEN 8 THEN '22:15'
    END,
    0  -- обе недели
FROM @days d
CROSS JOIN (VALUES (1),(2),(3),(4),(5),(6),(7),(8)) p(PairNumber);
