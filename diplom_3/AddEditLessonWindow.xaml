<Window x:Class="diplom_2.AddEditLessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, FallbackValue='Добавить занятие'}" 
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- День -->
        <TextBlock Grid.Row="0" Text="День недели *" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="1" ItemsSource="{Binding Days}" 
                  SelectedItem="{Binding SelectedDay}" Margin="0,0,0,12"/>

        <!-- Время -->
        <TextBlock Grid.Row="2" Text="Время (пара) *" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding TimeSlots}" 
                  SelectedItem="{Binding SelectedTimeSlot}" Margin="0,0,0,12"/>

        <!-- Аудитория -->
        <TextBlock Grid.Row="4" Text="Аудитория *" Margin="0,0,0,4" FontWeight="SemiBold"/>
        <TextBox Grid.Row="5" Text="{Binding Room, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,12"/>

        <!-- Предмет -->
        <TextBlock Grid.Row="6" Text="Предмет" Margin="0,0,0,4"/>
        <TextBox Grid.Row="7" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,12"/>

        <!-- Группа -->
        <TextBlock Grid.Row="8" Text="Группа" Margin="0,0,0,4"/>
        <TextBox Grid.Row="9" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,12"/>

        <!-- Преподаватель -->
        <TextBlock Grid.Row="10" Text="Преподаватель" Margin="0,0,0,4"/>
        <TextBox Grid.Row="11" Text="{Binding Teacher, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,20"/>

        <!-- Кнопки — привязаны к командам VM -->
        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="100" Margin="0,0,12,0" 
                    Command="{Binding CancelCommand}"/>
            <Button Content="Сохранить" Width="100" IsDefault="True" 
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>